# Copy this file to .env and fill in real values.
# Never commit .env — it's already in the root .gitignore.

ENVIRONMENT=development

# Supabase project settings (set up in the ERD/project-setup stage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server-side only, never sent to mobile/web clients
OPENAI_API_KEY=
