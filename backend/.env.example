# Copy this file to .env and fill in real values.
# Never commit .env — it's already in the root .gitignore.

ENVIRONMENT=development

# Demo mode — set true to run against the isolated local SQLite demo
# database (backend/demo_data.sqlite3) instead of Supabase. Used only
# while the real Supabase seeding is blocked; does not touch production
# schema or routes.
DEMO_MODE=false

# Base URL of the deployed provider web app — used only to build the
# redirect_to link in Supabase Auth's password-recovery email
# (POST /auth/forgot-password). Defaults to the local Vite dev server.
WEB_APP_URL=http://localhost:5173

# Supabase project settings
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API
# SUPABASE_ANON_KEY: same page, "anon public" key — used only by
# /auth/sign-in and /auth/refresh to check a user's password/token.
# Never use the service-role key for that.
SUPABASE_URL=https://your-project-ref.supabase.co


SUPABASE_ANON_KEY=replace-with-your-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service-role-key

# OpenAI — server-side only, never sent to mobile/web clients.
# OPENAI_MODEL is configurable on purpose: verify this exact string is
# available on your account before Phase 3 (live integration) begins.
# If it isn't, the app should fail with a clear config error rather than
# silently substituting a different model.
OPENAI_API_KEY=replace-with-your-own-openai-key
OPENAI_MODEL=gpt-5.6-terra

# AI workflow controls (used starting Phase 3/4)
AI_ENABLED=false
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_REQUIRE_SAFETY_REVIEW=true

# Synthetic seed-account credentials, used only by
# backend/scripts/seed_synthetic_users.py to create/reuse ONE fictional
# provider and ONE fictional patient in Supabase Auth for testing the
# real auth flow. Pick any fictional, non-guessable password — this is
# not a real patient and never will be. The script refuses to run if any
# of these four are left blank.
SEED_PROVIDER_EMAIL=provider.synthetic@carepulse.test
SEED_PROVIDER_PASSWORD=replace-with-a-fictional-test-password
SEED_PATIENT_EMAIL=patient.synthetic@carepulse.test
SEED_PATIENT_PASSWORD=replace-with-a-fictional-test-password

# A second synthetic provider, used only by
# backend/scripts/seed_second_provider.py so the reassignment feature has
# someone real to reassign a patient TO.
SEED_PROVIDER2_EMAIL=provider2.synthetic@carepulse.test
SEED_PROVIDER2_PASSWORD=replace-with-a-fictional-test-password
