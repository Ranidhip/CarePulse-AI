# Copy this file to .env and fill in real values.
# Never commit .env — it's already in the root .gitignore.

ENVIRONMENT=development

# Demo mode — set true to run against the isolated local SQLite demo
# database (backend/demo_data.sqlite3) instead of Supabase. Used only
# while the real Supabase seeding is blocked; does not touch production
# schema or routes.
DEMO_MODE=false

# Supabase project settings (set up in the ERD/project-setup stage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-key-never-commit-this

# OpenAI — server-side only, never sent to mobile/web clients
OPENAI_API_KEY=
